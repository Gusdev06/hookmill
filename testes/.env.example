# Testes da HookMill (copie pra testes/.env). Banco e bucket PRÓPRIOS dos testes.
E2E_WEB_URL=http://localhost:3000
# A API dos testes sobe numa porta própria (3101) com o env abaixo, pra nunca reaproveitar a API de dev (banco maquina).
E2E_API_PORT=3101
E2E_API_URL=http://localhost:3101/api/v1
E2E_DATABASE_URL=postgresql://maquina:maquina@localhost:5433/maquina_test?schema=public   # banco próprio dos testes
E2E_STORAGE_BUCKET=maquina-anuncios-test
E2E_OWNER_EMAIL=qa@teste.local
E2E_OWNER_PASSWORD=teste12345
# Comando que sobe a API (padrão: script "dev" do workspace api). O harness injeta DATABASE_URL, PORT, INTEGRACOES_MODE=mock etc.
# E2E_API_CMD=npm run start -w api   (sem watch de propósito)
