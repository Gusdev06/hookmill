NODE_ENV=development
PORT=3001
PUBLIC_API_URL=http://localhost:3001          # em prod: https://api.<dominio>; vira a URL do webhook
WEB_ORIGIN=http://localhost:3000              # CORS (lista separada por vírgula)

# Banco. Local = npm run infra:up (Postgres 17 na 5433). NUNCA aponte pro Supabase de produção em dev
# (o scripts/guard-db.mjs bloqueia migração/seed fora de localhost).
DATABASE_URL=postgresql://maquina:maquina@localhost:5433/maquina?schema=public
DIRECT_URL=postgresql://maquina:maquina@localhost:5433/maquina?schema=public
# Produção (Supabase), preenchido só no EasyPanel:
#   DATABASE_URL = pooler em modo TRANSAÇÃO (porta 6543) — o Prisma exige pgbouncer=true (sem prepared statements):
#     postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
#   DIRECT_URL   = pooler em modo SESSÃO (porta 5432, IPv4) — usado pelo prisma migrate (DDL e advisory lock não rodam no 6543):
#     postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
#   (a conexão "direta" db.<ref>.supabase.co é só IPv6 sem o add-on pago; por isso a sessão do pooler)

# Auth
JWT_ACCESS_SECRET=troque-por-64-chars-aleatorios
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
INVITE_TTL_DAYS=7

# Cadastro self-serve (docs/contratos/fase2-cadastro.md)
SIGNUP_ENABLED=true                           # false = POST /auth/signup responde 403 (fecha o cadastro sem deploy)
SIGNUP_DEFAULT_SPEND_CAP_USD=10               # teto mensal do 1º cliente criado pelo cadastro (vazio = sem teto)
SEED_OWNER_EMAIL=gusta@exemplo.com
SEED_OWNER_PASSWORD=troque-isto
SEED_WORKSPACE_NAME=Workspace

# Storage: interface S3 nos dois ambientes (dev = versitygw local; prod = Supabase Storage S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=maquina-anuncios
STORAGE_ACCESS_KEY_ID=maquina
STORAGE_SECRET_ACCESS_KEY=maquina-dev-secret
STORAGE_FORCE_PATH_STYLE=true                 # true nos dois (Supabase exige path style)
SIGNED_URL_TTL_SEC=21600
# Produção (Supabase → Storage → S3 Connection), só no EasyPanel:
#   STORAGE_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
#   STORAGE_REGION=<regiao do projeto, ex. sa-east-1>
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY = chave S3 do projeto (acesso total, ignora RLS: só no servidor)

# Integrações (maquina-ia)
INTEGRACOES_MODE=mock                         # mock | live  (testes e QA: sempre mock)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5               # aprovado 05/10
ANTHROPIC_EFFORT=medium
WAVESPEED_API_KEY=
WAVESPEED_WEBHOOK_SECRET=                     # sem o prefixo whsec_
WAVESPEED_WEBHOOKS=on                         # off = só reconciliador (dev sem túnel)
# Rosto: Higgsfield Soul V2 (header Authorization: Key <id>:<secret>). Vazias no live → submitFace falha NOT_CONFIGURED.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Regras de prompt de mídia: v2 é o padrão desde 06/10 (Gusta); v1 só pra comparar
MEDIA_PROMPTS=v2

# Feature 2: link da Ad Library (Apify, mesma conta/actor do ad-radar; no teto até 19/10 → AD_LIBRARY_UNAVAILABLE)
APIFY_TOKEN=
APIFY_AD_LIBRARY_ACTOR=curious_coder~facebook-ads-library-scraper
AD_LIBRARY_MODE=mock                          # mock | live | off (off = link sempre AD_LIBRARY_UNAVAILABLE not_configured)
# Meta v1 (docs/contratos/meta-v1.md, aprovado 21/10). Pré-requisitos só do Gusta: §11 do contrato (app no Meta for Developers).
META_MODE=mock                                # mock | live | off (off = /meta responde 503 META_NOT_CONFIGURED reason off; o web esconde o passo 2 e o Pick from Meta)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=                               # Facebook Login for Business → Configurations → Configuration ID
META_GRAPH_VERSION=v25.0                      # confirmar no painel no dia (D3); trocar aqui, sem deploy
META_TOKEN_KEY=                               # openssl rand -base64 32 (AES-256-GCM do token; trocar = todo mundo reconecta). Chave diferente por ambiente
META_WINNER_MIN_SPEND_USD=50                  # §5: elegível = gasto 30 d ≥ isto e ≥ META_WINNER_MIN_RESULTS resultados; WINNER = CPA ≤ mediana
META_WINNER_MIN_RESULTS=3
META_TREND_BETTER=0.85                        # §5.2: cpa7d ≤ 0,85 × anterior = WORKING
META_TREND_WORSE=1.25                         # cpa7d ≥ 1,25 × anterior = TIRING
META_TREND_FREQ=3                             # frequência 7 d ≥ 3 com CTR caindo 20 % = TIRING
META_USD_RATES=                               # opcional: BRL=5.5,EUR=0.92 (moeda da conta → USD pra regra do vencedor; vazio = 1:1)
META_SYNC_EVERY_HOURS=6
META_CRON=                                    # crons da Meta (sync + health 1×/dia) SÓ rodam com META_MODE=live; off = desliga em qualquer modo
                                              # (2ª API no mesmo banco, QA, debug). Fora de live a API nunca lê/sincroniza/marca uma conexão
                                              # real (metaUserId ≠ mock_user) — incidente 22/10: API mock no banco compartilhado derrubou o token.
# campanhas-v1 §4.1 (escritas na tela Campaigns)
META_BUDGET_MAX_STEP=2          # aumento de orçamento máximo por ação (× atual); acima = 422 META_BUDGET_STEP_TOO_LARGE
META_WRITES_PER_MIN=20          # escritas por workspace por minuto; acima = 429 RATE_LIMITED
META_WRITE_USAGE_CEILING=90     # % de uso da cota da Meta (BUC) a partir do qual escrita responde 503 rate_limited

# Feature 2: upload do campeão
UPLOAD_MODE=proxy                             # proxy (PUT pela API; dev) | direct (URL pré-assinada do storage; prod com CORS no bucket)
UPLOAD_MAX_BYTES=524288000                    # 500 MB (variacao-auto-v1 §2; o bucket tem que aceitar objeto desse tamanho)
CHAMPION_MIN_SEC=4                            # variacao-auto-v1 §2 (antes 5)
CHAMPION_MAX_SEC=180                          # 3 min (antes 120)

# Render (maquina-video)
RENDER_CONCURRENCY=1
RENDER_FRAMES_CONCURRENCY=1                   # frames em paralelo dentro de um render (opcional; subir só depois de medir memória)
RENDER_TMP_DIR=/tmp/maquina-render
REMOTION_BUNDLE_DIR=../video/dist/bundle      # vazio em dev = bundle na hora
REMOTION_BROWSER_EXECUTABLE=                  # OBRIGATÓRIA em produção: caminho do Chrome headless baixado no build da imagem.
                                              # Vazia (só dev) = ensureBrowser do Remotion, que travou e derrubou o Node na VPS.
                                              # Também alimenta o briefing por link (briefing-leitura-v2 §1b: render headless com
                                              # scroll + print pra visão, common/util/navegador.ts); sem binário a leitura segue só
                                              # por HTTP (readMode http) e a medição da landing fica sem print.
# Render: fake (testes) | local (Chrome na API, padrão dev; `remotion` = sinônimo) | lambda (prod). render-lambda-v1 §6.3.
# Vazio = fake com INTEGRACOES_MODE=mock, local no live.
RENDER_IMPL=                                  # vazio = regra acima (não muda o comportamento de quem copia este arquivo)
RENDER_LAMBDA_KINDS=scratch                   # kinds que vão pro Lambda com RENDER_IMPL=lambda (scratch,auto-edit,frame,remix-keep,template); o resto fica no local
ITERATE_TEMPLATES=off                         # iterate-v2 F1: on = CHAT_DM e PERSON_MOTION no catálogo do lote AUTO (off até o QA passar)
# Remotion Lambda (@remotion/lambda 4.0.533, igual ao remotion). Chave do usuário IAM de RENDER (L0/L5); nunca no git, nunca no chat.
REMOTION_AWS_REGION=us-east-1
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_FUNCTION=                     # saída do npm run lambda:deploy (sem ela + REMOTION_SERVE_URL o adaptador lambda fica desligado)
REMOTION_SERVE_URL=                           # idem (https:// do site hookmill-<sha> no S3)
REMOTION_LAMBDA_TIMEOUT_SEC=300               # = timeoutInSeconds da função; sem progresso por isto + 60 s = timeout (§2.7)
RENDER_LAMBDA_FRAMES_PER_LAMBDA=150           # frames por pedaço (egress do Supabase, §2.4); a sonda L1 confirma
RENDER_LAMBDA_MAX_INFLIGHT=20                 # renders no ar ao mesmo tempo (despachante; sobe depois da cota e da L4)
RENDER_LAMBDA_MAX_INFLIGHT_PER_WORKSPACE=10
RENDER_LAMBDA_POLL_MS=3000                    # intervalo do poller (getRenderProgress)
RENDER_LAMBDA_WEBHOOK=on                      # off = só polling (dev sem túnel)
RENDER_WEBHOOK_SECRET=                        # openssl rand -hex 32 (HMAC-SHA512 do webhook do Remotion); obrigatório com webhook on
RENDER_LAMBDA_DELAY_RENDER_MS=60000           # delayRender no Lambda (fontes + mídia remota); padrão do Remotion 30 s
RENDER_LAMBDA_MIN_URL_TTL_SEC=7200            # validade mínima da URL assinada da mídia no submit (SIGNED_URL_TTL_SEC tem que ser maior)
RENDER_LAMBDA_THROTTLE_WAIT_MS=15000          # espera depois de throttling da AWS antes de submeter de novo
REMOTION_LICENSE_KEY=                         # vazio enquanto Free (§7)

# Gasto
DEFAULT_MONTHLY_SPEND_CAP_USD=200

# Limites (opcionais). Em NODE_ENV=test, sem a variável, default e expensive sobem 100x; login nunca muda.
THROTTLE_DEFAULT_PER_MIN=600                  # por workspace (logado) ou IP (público)
THROTTLE_EXPENSIVE_PER_MIN=20                 # ações caras, por workspace
RENDER_LAMBDA_S3_ACCELERATE=off  # on = baixa a saída do Lambda pelo Transfer Acceleration (ligar no bucket antes); útil com a API longe de us-east-1
