NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en
SESSION_COOKIE_SECRET=troque-por-32-chars     # cifra o cookie httpOnly do refresh token
# Mock da API no navegador (MSW), opcional pra dev sem API: "enabled". Padrão: API real.
NEXT_PUBLIC_API_MOCKING=disabled
# NEXT_PUBLIC_ONBOARDING_EDDY=on  # onboarding conversacional com o Eddy (padrão: wizard de 6 passos)
# NEXT_PUBLIC_TEMPLATES=off  # templates-creditos-v1: volta a porta "Iterate a winner" (padrão: Templates + saldo de créditos; a API precisa de TEMPLATES=on onde isso subir)
